{
  "name": "agenttarmac-desktop",
  "productName": "AgentTarmac",
  "version": "0.2.0",
  "description": "AgentTarmac 桌面客户端（决策 D）：Electron 壳，托管本地 daemon 与统一任务看板",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "pack": "electron-builder --dir --win --x64"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.agenttarmac.desktop",
    "productName": "AgentTarmac",
    "artifactName": "AgentTarmac-Setup-${version}.${ext}",
    "files": ["main.js", "package.json"],
    "extraResources": [
      {
        "from": "../bin/agenthubd.exe",
        "to": "bin/agenthubd.exe",
        "filter": ["**/*"]
      },
      {
        "from": "../bin/agenthub-connect.exe",
        "to": "bin/agenthub-connect.exe",
        "filter": ["**/*"]
      },
      {
        "from": "../bin/hub-hook.exe",
        "to": "bin/hub-hook.exe",
        "filter": ["**/*"]
      },
      {
        "from": "icon.ico",
        "to": "icon.ico",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentTarmac"
    },
    "portable": {
      "artifactName": "AgentTarmac-Portable-${version}.${ext}"
    }
  }
}
